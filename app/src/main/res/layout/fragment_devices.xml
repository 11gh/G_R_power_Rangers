<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDeviceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device Name"
        android:textColor="#F3F7FD"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swMainRelay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/tvDeviceTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvDeviceTitle"
        app:thumbTint="@color/cyan_glow"
        app:trackDecorationTint="@color/cyan_glow" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:checkedButton="@+id/btnManual"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDeviceTitle"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManual"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual"
            android:textColor="#81ECFF"
            app:strokeColor="#81ECFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuto"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="#81ECFF"
            app:strokeColor="#81ECFF" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Auto Mode Settings Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAutoSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#1A2026"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/toggleGroupMode"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تحديد الحد الأقصى للتكلفة (ليرة)"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxStrokeColor="#81ECFF"
                app:hintTextColor="#81ECFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLimitPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="أدخل السعر بالليرة"
                    android:inputType="numberDecimal"
                    android:textColor="#F3F7FD" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="حفظ الإعدادات"
                app:backgroundTint="#81ECFF"
                android:textColor="#0E1418"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <GridLayout
        android:id="@+id/gridMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:columnCount="2"
        android:rowCount="3"
        app:layout_constraintTop_toBottomOf="@id/cardAutoSettings">

        <!-- التيار (Current) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="#1A2026"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تيار"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCurrentValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 A"
                android:textColor="#F3F7FD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الجهد (Voltage) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="#1A2026"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جهد"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvVoltageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 V"
                android:textColor="#F3F7FD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الاستطاعة (Power) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="#1A2026"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استطاعة"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPowerValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 W"
                android:textColor="#F3F7FD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- الاستطاعة بالواط الساعي (Energy) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="#1A2026"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="استطاعة (واط ساعي)"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEnergyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 Wh"
                android:textColor="#F3F7FD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- عامل الاستطاعة (Power Factor) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="#1A2026"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عامل استطاعة"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPFValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="#F3F7FD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- التردد (Frequency) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="#1A2026"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تردد"
                android:textColor="#A7ABB1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFrequencyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 Hz"
                android:textColor="#F3F7FD"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>