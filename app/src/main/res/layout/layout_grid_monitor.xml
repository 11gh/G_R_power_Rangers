<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#1A2026">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvGridTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grid Voltage"
            android:textColor="#A7ABB1"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="#2FF801"
            app:layout_constraintBottom_toBottomOf="@+id/tvStatusText"
            app:layout_constraintStart_toEndOf="@+id/tvGridTitle"
            app:layout_constraintTop_toTopOf="@+id/tvStatusText" />

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Stable"
            android:textColor="#2FF801"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvGridTitle"
            app:layout_constraintStart_toEndOf="@+id/statusDot"
            app:layout_constraintTop_toTopOf="@+id/tvGridTitle" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/gridChart"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tvGridTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/gridChart">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min"
                    android:textColor="#A7ABB1"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvMinVoltage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0V"
                    android:textColor="#F3F7FD"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current"
                    android:textColor="#A7ABB1"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvCurrentVoltage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0V"
                    android:textColor="#F3F7FD"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max"
                    android:textColor="#A7ABB1"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvMaxVoltage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0V"
                    android:textColor="#F3F7FD"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>