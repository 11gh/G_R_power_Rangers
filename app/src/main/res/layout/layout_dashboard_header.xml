<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@color/black">

    <TextView
        android:id="@+id/tv_system_telemetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SYSTEM TELEMETRY"
        android:textAllCaps="true"
        android:textColor="#A7ABB1"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:textStyle="bold" />

    <!-- Card 1: Power -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCurrentLoad"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#1A2026"
        app:cardCornerRadius="8dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/viewPowerAccent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#2FF801" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/viewPowerAccent"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT LOAD"
                    android:textColor="#A7ABB1"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPowerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.2"
                        android:textColor="#F3F7FD"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPowerUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="kW"
                        android:textColor="#2FF801"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_power"
                android:contentDescription="Power Icon" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card 2: Billing -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEstimatedBill"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        app:cardBackgroundColor="#1A2026"
        app:cardCornerRadius="8dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/viewBillAccent"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#81ECFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/viewBillAccent"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTIMATED BILL"
                    android:textColor="#A7ABB1"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBillValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24,500"
                        android:textColor="#F3F7FD"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="SYP"
                        android:textColor="#81ECFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="19dp"
                android:layout_height="18dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_bill"
                android:contentDescription="Bill Icon" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>